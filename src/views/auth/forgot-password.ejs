<h1 class="auth__title">Reset your password</h1>
<p class="auth__lede">Enter your email address and we will send you a reset link.</p>

<form class="form" method="post" action="/forgot-password" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="field">
    <label class="field__label" for="email">Email address</label>
    <input class="field__input" type="email" id="email" name="email" autocomplete="email"
           value="<%= values.email || '' %>" required>
    <% if (errors.email) { %><p class="field-error"><%= errors.email[0] %></p><% } %>
  </div>

  <button class="button button--primary button--block" type="submit">Send reset link</button>
</form>

<p class="auth__links"><a href="/login">Back to sign in</a></p>
