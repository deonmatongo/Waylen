<%# PRD §5.2 — 45-minute sessions, online or in person. %>
<section class="panel">
  <% if (counsellor) { %>
    <p class="panel__note">
      Your session will be with <strong><%= counsellor.fullName %></strong>.
    </p>
  <% } %>

  <form class="form" method="post" action="/portal/appointments">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label class="field__label" for="type">What would you like to discuss?</label>
      <select class="field__select" id="type" name="type" required>
        <% Object.entries(typeLabels).forEach(function (entry) { %>
          <option value="<%= entry[0] %>"><%= entry[1] %></option>
        <% }) %>
      </select>
    </div>

    <fieldset class="field field--fieldset">
      <legend class="field__label">How would you like to meet?</legend>
      <label class="radio">
        <input type="radio" name="format" value="ONLINE" checked>
        <span>Online — a Microsoft Teams link will be sent to you</span>
      </label>
      <label class="radio">
        <input type="radio" name="format" value="IN_PERSON">
        <span>In person at a Waylen office</span>
      </label>
    </fieldset>

    <div class="field">
      <label class="field__label" for="startsAt">Choose a slot</label>
      <select class="field__select" id="startsAt" name="startsAt" required>
        <option value="">Select a time</option>
        <% slots.slice(0, 80).forEach(function (slot) { %>
          <option value="<%= slot.toISOString() %>"><%= format.formatDateTime(slot) %></option>
        <% }) %>
      </select>
      <p class="field__hint">Sessions are <%= durationMinutes %> minutes.</p>
    </div>

    <div class="field">
      <label class="field__label" for="notes">Anything we should prepare? (optional)</label>
      <textarea class="field__textarea" id="notes" name="notes" rows="4"></textarea>
    </div>

    <button class="button button--primary" type="submit">Request appointment</button>
  </form>
</section>
