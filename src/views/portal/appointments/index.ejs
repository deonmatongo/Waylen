<div class="page-actions">
  <a class="button button--primary" href="/portal/appointments/new">Book an appointment</a>
</div>

<% if (upcoming.length) { %>
  <% var next = upcoming[0]; %>
  <section class="panel panel--highlight" aria-labelledby="next-appointment-title">
    <h2 class="panel__title" id="next-appointment-title">Your next appointment</h2>
    <p class="event-list__when">
      <time datetime="<%= next.startsAt.toISOString() %>"><%= zoned.dateTime(next.startsAt) %></time>
      <small>(<%= zoned.timeZone.replace(/_/g, ' ') %> time)</small>
    </p>
    <p class="event-list__what">
      <%= typeLabels[next.type] %>
      <span class="badge badge--<%= next.status === 'CONFIRMED' ? 'positive' : 'neutral' %>">
        <%= format.humaniseEnum(next.status) %>
      </span>
    </p>
    <p class="event-list__who">
      <%= next.durationMinutes %> minutes ·
      <%= format.humaniseEnum(next.format) %>
      <% if (next.counsellor) { %> · with <%= next.counsellor.fullName %><% } %>
    </p>
    <% if (next.format === 'ONLINE' && next.status === 'CONFIRMED' && !next.meetingUrl) { %>
      <p class="panel__note">Your meeting link is not ready yet. We will email it to you before the session.</p>
    <% } %>
    <% if (next.meetingUrl) { %>
      <a class="button button--primary button--small" href="<%= next.meetingUrl %>"
         rel="noopener" target="_blank">Join meeting</a>
    <% } %>
  </section>
<% } %>

<section class="panel">
  <h2 class="panel__title">Upcoming</h2>

  <% if (!upcoming.length) { %>
    <p class="panel__note">Nothing booked.</p>
  <% } else { %>
    <ul class="event-list">
      <% upcoming.forEach(function (appointment) { %>
        <li class="event-list__item">
          <time class="event-list__when" datetime="<%= appointment.startsAt.toISOString() %>">
            <%= zoned.dateTime(appointment.startsAt) %>
          </time>
          <p class="event-list__what">
            <%= typeLabels[appointment.type] %>
            <span class="badge badge--<%= appointment.status === 'CONFIRMED' ? 'positive' : 'neutral' %>">
              <%= format.humaniseEnum(appointment.status) %>
            </span>
          </p>
          <p class="event-list__who">
            <%= appointment.durationMinutes %> minutes ·
            <%= format.humaniseEnum(appointment.format) %>
            <% if (appointment.counsellor) { %> · with <%= appointment.counsellor.fullName %><% } %>
          </p>

          <div class="event-list__actions">
            <% if (appointment.meetingUrl) { %>
              <a class="button button--secondary button--small" href="<%= appointment.meetingUrl %>"
                 rel="noopener" target="_blank">Join meeting</a>
            <% } %>
            <% if (appointment.canReschedule) { %>
              <a class="button button--ghost button--small"
                 href="/portal/appointments/<%= appointment.id %>/reschedule">Reschedule</a>
            <% } %>
            <form method="post" action="/portal/appointments/<%= appointment.id %>/cancel" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="link-button link-button--danger" type="submit">Cancel</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<% if (past.length) { %>
  <section class="panel">
    <h2 class="panel__title">Past appointments</h2>

    <table class="table">
      <thead>
        <tr><th scope="col">When</th><th scope="col">Type</th><th scope="col">Status</th></tr>
      </thead>
      <tbody>
        <% past.forEach(function (appointment) { %>
          <tr>
            <td><%= zoned.dateTime(appointment.startsAt) %></td>
            <td><%= typeLabels[appointment.type] %></td>
            <td><%= format.humaniseEnum(appointment.status) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%- include('../../partials/pagination', { results: pagination, baseUrl: '/portal/appointments', query: {} }) %>
  </section>
<% } %>
