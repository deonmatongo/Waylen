<% if (!applications.length) { %>
  <%- include('../../partials/empty-state', {
        heading: 'No applications yet',
        message: 'Once your documents have been reviewed, your counsellor will add your recommended programme/application here.',
        actionHref: '/portal/documents',
        actionLabel: 'View application checklist'
      }) %>
<% } else { %>
  <ul class="record-list">
    <% applications.forEach(function (application) { %>
      <% var step = cardStep[application.stage]; %>
      <li class="record-list__item">
        <div class="record-list__body">
          <p class="record-list__eyebrow"><code><%= application.reference %></code></p>
          <h2 class="record-list__title">
            <a href="/portal/applications/<%= application.id %>">
              <%= application.programmeName || 'Application in preparation' %>
            </a>
          </h2>

          <dl class="record-list__meta">
            <% if (application.institution) { %>
              <div><dt>Institution</dt><dd><%= application.institution.name %></dd></div>
            <% } %>
            <% if (application.country) { %>
              <div><dt>Destination</dt><dd><%= application.country.name %></dd></div>
            <% } %>
            <% if (application.intakePeriod) { %>
              <div><dt>Intake</dt><dd><%= application.intakePeriod %></dd></div>
            <% } %>
            <% if (application.applicationDeadline) { %>
              <div><dt>Deadline</dt><dd><%= format.formatDate(application.applicationDeadline) %></dd></div>
            <% } %>
          </dl>

          <ol class="mini-path" aria-label="Application status">
            <% cardPath.forEach(function (label, index) { %>
              <li class="mini-path__step<%= index < step ? ' mini-path__step--complete' : index === step ? ' mini-path__step--current' : '' %>">
                <%= label %>
              </li>
            <% }) %>
          </ol>
        </div>

        <div class="record-list__actions">
          <span class="badge badge--neutral"><%= format.humaniseEnum(application.outcome) %></span>
          <a class="button button--secondary button--small" href="/portal/applications/<%= application.id %>">
            View
          </a>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>
