<%# Required Documents — client navigation feedback: a real checklist with %>
<%# status, not just a "N still needed" count. %>
<%- include('../../partials/portal-subnav', { tabs: documentsTabs }) %>

<section class="panel">
  <h2 class="panel__title">What we need from you</h2>
  <p class="panel__note">These documents are required before your application can move forward.</p>

  <table class="table">
    <thead>
      <tr>
        <th scope="col">Document</th>
        <th scope="col">Status</th>
        <th scope="col"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% checklist.forEach(function (item) { %>
        <tr>
          <td><%= item.label %></td>
          <td>
            <% if (!item.status) { %>
              <span class="badge badge--neutral">Not uploaded</span>
            <% } else { %>
              <span class="badge badge--<%= item.status === 'APPROVED' ? 'positive' : item.status === 'NEEDS_CORRECTION' ? 'negative' : 'neutral' %>">
                <%= statusLabels[item.status] %>
              </span>
            <% } %>
          </td>
          <td class="table__actions">
            <% if (item.documentId) { %>
              <a class="link-button" href="/portal/documents/<%= item.documentId %>/download">View</a>
            <% } else { %>
              <a class="link-button" href="/portal/documents">Upload</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
