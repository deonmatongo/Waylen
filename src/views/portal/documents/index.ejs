<%# PRD §5.2 — upload, review status, and correction feedback. %>
<% if (outstanding.length) { %>
  <div class="notice notice--action">
    <p class="notice__title">
      <%= outstanding.length %> document<%= outstanding.length === 1 ? '' : 's' %> still needed
    </p>
    <p class="notice__body"><%= outstanding.map(function (o) { return o.label; }).join(', ') %></p>
  </div>
<% } %>

<section class="panel">
  <h2 class="panel__title">Upload a document</h2>
  <p class="panel__note">
    PDF, JPG, PNG or Word, up to 15&nbsp;MB. Your documents are encrypted and only
    visible to you and the Waylen team.
  </p>

  <%# CSRF token is on the query string, not just the hidden field below —
      this is a multipart form, and the global CSRF check runs before
      multer parses the body, so it never sees a `_csrf` body field. %>
  <form class="form form--inline" method="post" action="/portal/documents?_csrf=<%= encodeURIComponent(csrfToken) %>"
        enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label class="field__label" for="type">Document type</label>
      <select class="field__select" id="type" name="type" required>
        <option value="">Select a type</option>
        <% uploadableTypes.forEach(function (item) { %>
          <option value="<%= item.value %>"><%= item.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label class="field__label" for="document">File</label>
      <input class="field__file" type="file" id="document" name="document" required
             accept=".pdf,.jpg,.jpeg,.png,.heic,.doc,.docx">
    </div>

    <button class="button button--primary" type="submit">Upload</button>
  </form>
</section>

<section class="panel">
  <h2 class="panel__title">Your documents</h2>

  <% if (!documents.length) { %>
    <p class="panel__note">You have not uploaded anything yet.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Type</th>
          <th scope="col">File</th>
          <th scope="col">Status</th>
          <th scope="col">Uploaded</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% documents.forEach(function (document) { %>
          <tr>
            <td><%= format.humaniseEnum(document.type) %></td>
            <td>
              <%= document.originalFilename %>
              <small class="table__hint"><%= format.formatFileSize(document.sizeBytes) %></small>
            </td>
            <td>
              <span class="badge badge--<%= document.status === 'APPROVED' ? 'positive' : document.status === 'NEEDS_CORRECTION' ? 'negative' : 'neutral' %>">
                <%= format.humaniseEnum(document.status) %>
              </span>
              <% if (document.status === 'NEEDS_CORRECTION' && document.reviewNotes) { %>
                <p class="table__note"><%= document.reviewNotes %></p>
              <% } %>
            </td>
            <td><%= format.formatDate(document.createdAt) %></td>
            <td class="table__actions">
              <a class="link-button" href="/portal/documents/<%= document.id %>/download">Download</a>

              <% if (document.status !== 'APPROVED') { %>
                <form method="post" action="/portal/documents/<%= document.id %>/delete" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="link-button link-button--danger" type="submit">Remove</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
