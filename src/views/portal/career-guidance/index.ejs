<%# Career Guidance workspace (client navigation feedback) — lives under %>
<%# Services rather than its own sidebar item, but reads as its own place: %>
<%# what's ready to use today, and what's coming, side by side. %>
<section class="panel">
  <h2 class="panel__title">Career guidance</h2>
  <p class="panel__note">
    Work through your options with a counsellor — choosing a first path, or
    progressing into senior and leadership roles once you are established.
  </p>
</section>

<div class="dash-grid dash-grid--2">
  <section class="panel">
    <h2 class="panel__title">One-to-one career session</h2>
    <p class="panel__note">
      Book time with a counsellor to talk through your options and next steps.
    </p>
    <a class="button button--primary" href="/portal/appointments/new">Book a session</a>
  </section>

  <section class="panel">
    <h2 class="panel__title">Career assessment</h2>
    <p class="panel__note">
      A structured assessment that produces personalised programme and career
      recommendations.
    </p>
    <a class="button button--secondary" href="/portal/career-guidance/assessment">Start the assessment</a>
  </section>
</div>

<%- include('../../partials/coming-soon', {
      title: 'Personalised recommendations & career report',
      detail: 'Once you\'ve completed a career assessment, your recommendations and a full career report will appear here.'
    }) %>
