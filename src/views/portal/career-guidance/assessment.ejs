<%# PRD §5.2 — self-assessment feeding personalised recommendations. %>
<section class="panel">
  <p class="panel__note">
    Answer every question as it feels truest for you right now — there are no
    right or wrong answers. It takes about five minutes, and your
    recommendations are generated the moment you submit.
  </p>

  <form class="form" method="post" action="/portal/career-guidance/assessment">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% questions.forEach(function (question, index) { %>
      <fieldset class="field field--fieldset">
        <legend class="field__label"><%= index + 1 %>. <%= question.prompt %></legend>
        <% question.options.forEach(function (option) { %>
          <label class="radio">
            <input type="radio" name="<%= question.id %>" value="<%= option.id %>" required>
            <span><%= option.label %></span>
          </label>
        <% }) %>
      </fieldset>
    <% }) %>

    <button class="button button--primary" type="submit">See my recommendations</button>
  </form>
</section>
