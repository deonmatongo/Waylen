<% if (typeof paymentNotice !== 'undefined' && paymentNotice) { %>
  <div class="flash-stack" role="status" aria-live="polite">
    <div class="flash flash--<%= paymentNotice.type %>"><p class="flash__message"><%= paymentNotice.message %></p></div>
  </div>
<% } %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/portal/invoices">Invoices</a>
  <span aria-hidden="true">/</span>
  <span><%= invoice.number %></span>
</nav>

<div class="page-actions">
  <% if (invoice.payments.some(function (p) { return p.status === 'SUCCEEDED'; })) { %>
    <a class="button button--secondary" href="/portal/invoices/<%= invoice.id %>/receipt" target="_blank" rel="noopener">
      Print / save receipt
    </a>
  <% } %>
</div>

<section class="panel">
  <dl class="detail-list">
    <div><dt>Invoice number</dt><dd><code><%= invoice.number %></code></dd></div>
    <div><dt>Status</dt><dd><%- include('_status-badge', { invoice: invoice }) %></dd></div>
    <div><dt>Issued</dt><dd><%= format.formatDate(invoice.issuedAt) %></dd></div>
    <div><dt>Due</dt><dd><%= format.formatDate(invoice.dueAt) %></dd></div>
  </dl>

  <table class="table">
    <thead>
      <tr><th scope="col">Description</th><th scope="col">Qty</th><th scope="col">Unit price</th><th scope="col">Total</th></tr>
    </thead>
    <tbody>
      <% invoice.lineItems.forEach(function (item) { %>
        <tr>
          <td><%= item.description %></td>
          <td><%= item.quantity %></td>
          <td><%= format.formatMoney(item.unitPriceMinor, invoice.currency) %></td>
          <td><%= format.formatMoney(item.totalMinor, invoice.currency) %></td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr><th scope="row" colspan="3">Subtotal</th><td><%= format.formatMoney(invoice.subtotalMinor, invoice.currency) %></td></tr>
      <% if (invoice.taxMinor > 0) { %>
        <tr><th scope="row" colspan="3">Tax</th><td><%= format.formatMoney(invoice.taxMinor, invoice.currency) %></td></tr>
      <% } %>
      <tr><th scope="row" colspan="3">Total</th><td><strong><%= format.formatMoney(invoice.totalMinor, invoice.currency) %></strong></td></tr>
      <tr><th scope="row" colspan="3">Paid</th><td><%= format.formatMoney(invoice.paidMinor, invoice.currency) %></td></tr>
      <tr><th scope="row" colspan="3">Outstanding</th><td><strong><%= format.formatMoney(invoice.totalMinor - invoice.paidMinor, invoice.currency) %></strong></td></tr>
    </tfoot>
  </table>
</section>

<% if (['SENT', 'PARTIALLY_PAID', 'OVERDUE'].includes(invoice.status)) { %>
  <section class="panel">
    <h2 class="panel__title">Pay online by card</h2>
    <p class="panel__note">
      Pay the outstanding balance of <%= format.formatMoney(invoice.totalMinor - invoice.paidMinor, invoice.currency) %>
      now by card, Apple Pay or Google Pay.
    </p>
    <form method="post" action="/portal/invoices/<%= invoice.id %>/pay?_csrf=<%= encodeURIComponent(csrfToken) %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="button button--primary" type="submit">Pay now</button>
    </form>
  </section>

  <section class="panel">
    <h2 class="panel__title">Upload proof of payment</h2>
    <p class="panel__note">
      Paid by bank transfer, SWIFT, Revolut or cash? Attach your receipt or transfer
      confirmation and we will confirm it against your invoice.
    </p>

    <%# CSRF token is on the query string, not just the hidden field below —
        this is a multipart form, and the global CSRF check runs before
        multer parses the body, so it never sees a `_csrf` body field. %>
    <form class="form form--inline" method="post"
          action="/portal/invoices/<%= invoice.id %>/proof-of-payment?_csrf=<%= encodeURIComponent(csrfToken) %>"
          enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label class="field__label" for="method">Method</label>
        <select class="field__select" id="method" name="method" required>
          <option value="BANK_TRANSFER">Bank transfer</option>
          <option value="SWIFT">SWIFT</option>
          <option value="REVOLUT">Revolut</option>
          <option value="CASH">Cash</option>
        </select>
      </div>

      <div class="field">
        <label class="field__label" for="amountMinor">Amount paid (in cents)</label>
        <input class="field__input" type="number" id="amountMinor" name="amountMinor"
               min="1" step="1" required value="<%= invoice.totalMinor - invoice.paidMinor %>">
      </div>

      <div class="field">
        <label class="field__label" for="manualReference">Reference (optional)</label>
        <input class="field__input" type="text" id="manualReference" name="manualReference">
      </div>

      <div class="field">
        <label class="field__label" for="document">Receipt or confirmation</label>
        <input class="field__file" type="file" id="document" name="document" required
               accept=".pdf,.jpg,.jpeg,.png,.heic,.doc,.docx">
      </div>

      <button class="button button--primary" type="submit">Submit for confirmation</button>
    </form>
  </section>
<% } %>

<% if (invoice.payments.length) { %>
  <section class="panel">
    <h2 class="panel__title">Payment history</h2>
    <table class="table">
      <thead>
        <tr><th scope="col">Date</th><th scope="col">Method</th><th scope="col">Amount</th><th scope="col">Status</th></tr>
      </thead>
      <tbody>
        <% invoice.payments.forEach(function (payment) { %>
          <tr>
            <td><%= format.formatDate(payment.paidAt || payment.createdAt) %></td>
            <td><%= format.humaniseEnum(payment.method) %></td>
            <td><%= format.formatMoney(payment.amountMinor, payment.currency) %></td>
            <td>
              <span class="badge badge--<%= payment.status === 'SUCCEEDED' ? 'positive' : payment.status === 'FAILED' ? 'negative' : 'neutral' %>">
                <%= format.humaniseEnum(payment.status) %>
              </span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<%# Handled by public/js/app.js — CSP (script-src 'self') blocks inline scripts. %>
<% if (typeof autoPrint !== 'undefined' && autoPrint) { %>
  <span data-auto-print hidden></span>
<% } %>
