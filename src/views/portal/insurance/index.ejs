<section class="panel">
  <h2 class="panel__title">Your cover</h2>

  <% if (!policies.length) { %>
    <p class="panel__note">You do not have a policy with us yet.</p>
    <a class="button button--primary" href="/portal/insurance/quote">Get a quote</a>
  <% } else { %>
    <table class="table">
      <thead>
        <tr><th scope="col">Plan</th><th scope="col">Policy number</th><th scope="col">Cover</th><th scope="col">Status</th></tr>
      </thead>
      <tbody>
        <% policies.forEach(function (policy) { %>
          <tr>
            <td><%= policy.planName %></td>
            <td><%= policy.policyNumber || '—' %></td>
            <td>
              <% if (policy.coverageStartsAt && policy.coverageEndsAt) { %>
                <%= format.formatDate(policy.coverageStartsAt) %> – <%= format.formatDate(policy.coverageEndsAt) %>
              <% } else { %>
                Dates to be confirmed
              <% } %>
            </td>
            <td>
              <span class="badge badge--<%= policy.status === 'ACTIVE' ? 'positive' : policy.status === 'CANCELLED' || policy.status === 'EXPIRED' ? 'neutral' : 'warning' %>">
                <%= format.humaniseEnum(policy.status) %>
              </span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
