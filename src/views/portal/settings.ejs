<div class="dash-grid">
  <section class="panel">
    <h2 class="panel__title">Change your password</h2>

    <form class="form" method="post" action="/portal/settings/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label class="field__label" for="currentPassword">Current password</label>
        <input class="field__input" type="password" id="currentPassword" name="currentPassword"
               autocomplete="current-password" required>
      </div>

      <div class="field">
        <label class="field__label" for="password">New password</label>
        <input class="field__input" type="password" id="password" name="password"
               autocomplete="new-password" required>
        <p class="field__hint">At least 10 characters, with an uppercase letter and a number.</p>
      </div>

      <div class="field">
        <label class="field__label" for="passwordConfirmation">Confirm new password</label>
        <input class="field__input" type="password" id="passwordConfirmation" name="passwordConfirmation"
               autocomplete="new-password" required>
      </div>

      <button class="button button--primary" type="submit">Change password</button>
    </form>

    <hr class="rule">

    <h2 class="panel__title">Your account</h2>
    <dl class="detail-list">
      <div><dt>Student reference</dt><dd><code><%= student.reference %></code></dd></div>
      <% if (student.countryOfOrigin) { %>
        <div><dt>Country of origin</dt><dd><%= student.countryOfOrigin.name %></dd></div>
      <% } %>
      <div><dt>Registered</dt><dd><%= format.formatDate(student.createdAt) %></dd></div>
    </dl>
  </section>
</div>
