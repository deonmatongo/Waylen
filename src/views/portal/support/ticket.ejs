<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/portal/support/tickets">My tickets</a>
  <span aria-hidden="true">/</span>
  <span><%= ticket.subject %></span>
</nav>

<section class="panel">
  <p class="panel__note"><code><%= ticket.reference %></code> · <%= categoryLabels[ticket.category] %></p>
  <h2 class="panel__title">
    <%= ticket.subject %>
    <span class="badge badge--<%= ticket.status === 'RESOLVED' ? 'positive' : ticket.status === 'AWAITING_STUDENT' ? 'warning' : ticket.status === 'IN_PROGRESS' ? 'info' : 'negative' %>">
      <%= statusLabels[ticket.status] %>
    </span>
  </h2>

  <ol class="thread">
    <% ticket.messages.forEach(function (message) { %>
      <li class="thread__message thread__message--<%= message.sender.role === 'STUDENT' ? 'mine' : 'theirs' %>">
        <header class="thread__meta">
          <strong><%= message.sender.fullName %></strong>
          <time datetime="<%= message.createdAt.toISOString() %>">
            <%= format.formatDateTime(message.createdAt) %>
          </time>
        </header>
        <p class="thread__body"><%= message.body %></p>
      </li>
    <% }) %>
  </ol>
</section>

<section class="panel">
  <h2 class="panel__title">Reply</h2>

  <form class="form" method="post" action="/portal/support/tickets/<%= ticket.id %>/reply">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label class="field__label visually-hidden" for="body">Your reply</label>
      <textarea class="field__textarea" id="body" name="body" rows="4" required></textarea>
    </div>

    <button class="button button--primary" type="submit">Send reply</button>
  </form>
  <% if (ticket.status === 'RESOLVED') { %>
    <p class="panel__note">Replying will reopen this ticket.</p>
  <% } %>
</section>
