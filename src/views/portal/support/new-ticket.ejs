<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/portal/support/tickets">My tickets</a>
  <span aria-hidden="true">/</span>
  <span>New ticket</span>
</nav>

<section class="panel">
  <h2 class="panel__title">Raise a ticket</h2>

  <form class="form" method="post" action="/portal/support/tickets">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label class="field__label" for="category">Category</label>
      <select class="field__select" id="category" name="category" required>
        <% Object.entries(categoryLabels).forEach(function ([value, label]) { %>
          <option value="<%= value %>"><%= label %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label class="field__label" for="subject">Subject</label>
      <input class="field__input" type="text" id="subject" name="subject" required maxlength="160">
    </div>

    <div class="field">
      <label class="field__label" for="body">Describe the issue</label>
      <textarea class="field__textarea" id="body" name="body" rows="6" required></textarea>
    </div>

    <button class="button button--primary" type="submit">Submit ticket</button>
  </form>
</section>
