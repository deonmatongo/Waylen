<section class="section section--centered">
  <div class="section__inner section__inner--narrow">
    <p class="error-page__code" aria-hidden="true"><%= status %></p>
    <h1 class="section__title">No access</h1>
    <p class="section__lede"><%= message || 'You do not have permission to view that page.' %></p>

    <p class="section__footer">
      <a class="button button--primary" href="/">Back to the homepage</a>
      <a class="button button--secondary" href="/contact">Contact us</a>
    </p>

    <% if (stack) { %>
      <%# Development only — errorHandler passes null in production. %>
      <pre class="error-page__stack"><code><%= stack %></code></pre>
    <% } %>
  </div>
</section>
