<%# Expects `heading`, optional `message`, optional `actionHref`/`actionLabel`. %>
<div class="empty-state">
  <h2 class="empty-state__heading"><%= heading %></h2>
  <% if (typeof message !== 'undefined' && message) { %>
    <p class="empty-state__message"><%= message %></p>
  <% } %>
  <% if (typeof actionHref !== 'undefined' && actionHref) { %>
    <a class="button button--primary" href="<%= actionHref %>"><%= actionLabel %></a>
  <% } %>
</div>
