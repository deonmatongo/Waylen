<ul class="card-grid card-grid--2">
  <li class="card card--feature">
    <h2 class="card__title">Learning Hub</h2>
    <p class="card__body"><%= counts.resourceCount %> articles, guides and downloads.</p>
    <a class="card__link" href="/admin/content/resources">Manage content</a>
  </li>
  <li class="card card--feature">
    <h2 class="card__title">Opportunities</h2>
    <p class="card__body"><%= counts.opportunityCount %> programme listings.</p>
    <a class="card__link" href="/admin/content/opportunities">Manage listings</a>
  </li>
  <li class="card card--feature">
    <h2 class="card__title">FAQs</h2>
    <p class="card__body"><%= counts.faqCount %> questions across all topics.</p>
    <a class="card__link" href="/admin/content/faqs">Manage FAQs</a>
  </li>
  <li class="card card--feature">
    <h2 class="card__title">Testimonials</h2>
    <p class="card__body"><%= counts.testimonialCount %> student and partner testimonials.</p>
    <a class="card__link" href="/admin/content/testimonials">Manage testimonials</a>
  </li>
</ul>
