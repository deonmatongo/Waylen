<%# PRD §5.4, §10 — the operational picture on one screen. %>
<div class="dash-welcome" style="margin-bottom:var(--sp-5)">
  <div class="dash-welcome__inner">
    <p class="dash-welcome__greeting">Operations overview</p>
    <p class="dash-welcome__status">
      <span class="dash-welcome__badge">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:10px;height:10px"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Live
      </span>
      <span>Real-time snapshot · Back office</span>
    </p>
  </div>
</div>

<dl class="stat-row stat-row--cards">
  <div class="stat stat--card">
    <div class="stat__icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <dt class="stat__label">Students</dt>
    <dd class="stat__value"><%= studentCount %></dd>
  </div>
  <div class="stat stat--card">
    <div class="stat__icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
    </div>
    <dt class="stat__label">Documents awaiting review</dt>
    <dd class="stat__value"><%= reviewQueue.length %></dd>
  </div>
  <div class="stat stat--card">
    <div class="stat__icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <dt class="stat__label">Upcoming appointments</dt>
    <dd class="stat__value"><%= upcomingAppointments.length %></dd>
  </div>
  <div class="stat stat--card">
    <div class="stat__icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
    </div>
    <dt class="stat__label">New enquiries</dt>
    <dd class="stat__value"><%= newEnquiries %></dd>
  </div>
</dl>

<section class="panel">
  <h2 class="panel__title">
    <span class="panel__title-icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      Pipeline
    </span>
  </h2>

  <ul class="pipeline">
    <% pipeline.forEach(function (step) { %>
      <li class="pipeline__stage">
        <span class="pipeline__count"><%= step.count %></span>
        <span class="pipeline__label"><%= step.label %></span>
      </li>
    <% }) %>
  </ul>
</section>

<div class="dash-grid dash-grid--2">
  <section class="panel">
    <h2 class="panel__title">
      <span class="panel__title-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        Document review queue
      </span>
    </h2>

    <% if (!reviewQueue.length) { %>
      <p class="panel__note panel__note--positive">Nothing waiting. The queue is clear.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr><th scope="col">Student</th><th scope="col">Document</th><th scope="col">Waiting</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
        </thead>
        <tbody>
          <% reviewQueue.forEach(function (document) { %>
            <tr>
              <td>
                <a href="/admin/students/<%= document.studentProfile.id %>">
                  <%= document.studentProfile.user.fullName %>
                </a>
                <small class="table__hint"><%= document.studentProfile.reference %></small>
              </td>
              <td><%= format.humaniseEnum(document.type) %></td>
              <td><%= format.relativeTime(document.createdAt) %></td>
              <td class="table__actions">
                <a class="link-button" href="/admin/documents/<%= document.id %>/view">Review</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="panel__footer"><a href="/admin/documents">Full review queue</a></p>
    <% } %>
  </section>

  <section class="panel">
    <h2 class="panel__title">
      <span class="panel__title-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Upcoming appointments
      </span>
    </h2>

    <% if (!upcomingAppointments.length) { %>
      <p class="panel__note">Nothing scheduled.</p>
    <% } else { %>
      <ul class="event-list">
        <% upcomingAppointments.forEach(function (appointment) { %>
          <li class="event-list__item">
            <time class="event-list__when" datetime="<%= appointment.startsAt.toISOString() %>">
              <%= format.formatDateTime(appointment.startsAt) %>
            </time>
            <p class="event-list__what">
              <%= format.humaniseEnum(appointment.type) %>
              <span class="badge badge--<%= appointment.status === 'CONFIRMED' ? 'positive' : 'neutral' %>">
                <%= format.humaniseEnum(appointment.status) %>
              </span>
            </p>
            <p class="event-list__who">
              <%= appointment.studentProfile ? appointment.studentProfile.user.fullName : appointment.guestName %>
            </p>
          </li>
        <% }) %>
      </ul>
      <p class="panel__footer"><a href="/admin/appointments">All appointments</a></p>
    <% } %>
  </section>
</div>
