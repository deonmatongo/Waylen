<%# PRD §5.4 — view, search, filter, assign counsellor, status at a glance. %>
<form class="filters filters--bar" method="get" action="/admin/students">
  <div class="field">
    <label class="field__label visually-hidden" for="q">Search</label>
    <input class="field__input" type="search" id="q" name="q" value="<%= filters.q || '' %>"
           placeholder="Name, email or reference">
  </div>

  <div class="field">
    <label class="field__label visually-hidden" for="stage">Stage</label>
    <select class="field__select" id="stage" name="stage">
      <option value="">All stages</option>
      <% stages.forEach(function (stage) { %>
        <option value="<%= stage.value %>" <%= filters.stage === stage.value ? 'selected' : '' %>>
          <%= stage.label %>
        </option>
      <% }) %>
    </select>
  </div>

  <div class="field">
    <label class="field__label visually-hidden" for="counsellor">Counsellor</label>
    <select class="field__select" id="counsellor" name="counsellor">
      <option value="">All counsellors</option>
      <% counsellors.forEach(function (counsellor) { %>
        <option value="<%= counsellor.id %>" <%= filters.counsellor === counsellor.id ? 'selected' : '' %>>
          <%= counsellor.fullName %> (<%= counsellor._count.counselledStudents %>)
        </option>
      <% }) %>
    </select>
  </div>

  <button class="button button--primary" type="submit">Filter</button>
  <a class="button button--ghost" href="/admin/students">Clear</a>
</form>

<p class="listing-layout__count"><%= results.total %> student<%= results.total === 1 ? '' : 's' %></p>

<% if (!results.items.length) { %>
  <%- include('../../partials/empty-state', { heading: 'No students match those filters' }) %>
<% } else { %>
  <table class="table table--stacked">
    <thead>
      <tr>
        <th scope="col">Student</th><th scope="col">Reference</th><th scope="col">Origin</th>
        <th scope="col">Stage</th><th scope="col">Counsellor</th><th scope="col">Docs</th>
        <th scope="col">Registered</th><th scope="col"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% results.items.forEach(function (student) { %>
        <tr>
          <td>
            <a href="/admin/students/<%= student.id %>"><%= student.user.fullName %></a>
            <small class="table__hint"><%= student.user.email %></small>
          </td>
          <td><code><%= student.reference %></code></td>
          <td><%= student.countryOfOrigin ? student.countryOfOrigin.name : '—' %></td>
          <td><span class="badge badge--neutral"><%= format.humaniseEnum(student.currentStage) %></span></td>
          <td><%= student.assignedCounsellor ? student.assignedCounsellor.fullName : '<span class="table__hint">Unassigned</span>' %></td>
          <td><%= student._count.documents %></td>
          <td><%= format.formatDate(student.createdAt) %></td>
          <td class="table__actions">
            <a class="link-button" href="/admin/students/<%= student.id %>">Open</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <%- include('../../partials/pagination', { results: results, baseUrl: '/admin/students', query: filters }) %>
<% } %>
