<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/admin/support">Support tickets</a>
  <span aria-hidden="true">/</span>
  <span><%= ticket.subject %></span>
</nav>

<div class="dash-grid dash-grid--2">
  <section class="panel">
    <p class="panel__note"><code><%= ticket.reference %></code> · <%= format.humaniseEnum(ticket.category) %></p>
    <h2 class="panel__title">
      <%= ticket.subject %>
      <span class="badge badge--<%= ticket.status === 'RESOLVED' ? 'positive' : ticket.status === 'AWAITING_STUDENT' ? 'warning' : ticket.status === 'IN_PROGRESS' ? 'info' : 'negative' %>">
        <%= format.humaniseEnum(ticket.status) %>
      </span>
    </h2>

    <dl class="detail-list">
      <div>
        <dt>Student</dt>
        <dd>
          <a href="/admin/students/<%= ticket.studentProfile.id %>">
            <%= ticket.studentProfile.user.fullName %> (<%= ticket.studentProfile.reference %>)
          </a>
        </dd>
      </div>
      <div><dt>Raised</dt><dd><%= format.formatDateTime(ticket.createdAt) %></dd></div>
      <div><dt>Resolved</dt><dd><%= ticket.resolvedAt ? format.formatDateTime(ticket.resolvedAt) : 'Not yet' %></dd></div>
    </dl>

    <ol class="thread">
      <% ticket.messages.forEach(function (message) { %>
        <li class="thread__message thread__message--<%= message.sender.role === 'STUDENT' ? 'theirs' : 'mine' %>">
          <header class="thread__meta">
            <strong><%= message.sender.fullName %></strong>
            <% if (message.isInternal) { %><span class="badge badge--neutral">Internal note</span><% } %>
            <time datetime="<%= message.createdAt.toISOString() %>">
              <%= format.formatDateTime(message.createdAt) %>
            </time>
          </header>
          <p class="thread__body"><%= message.body %></p>
        </li>
      <% }) %>
    </ol>

    <form class="form" method="post" action="/admin/support/<%= ticket.id %>/reply">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label class="field__label visually-hidden" for="body">Reply</label>
        <textarea class="field__textarea" id="body" name="body" rows="4" required></textarea>
      </div>

      <div class="field">
        <label class="field__label" for="isInternal">
          <input type="checkbox" id="isInternal" name="isInternal" value="1">
          Internal note (hidden from the student)
        </label>
      </div>

      <button class="button button--primary" type="submit">Send</button>
    </form>
  </section>

  <section class="panel">
    <h2 class="panel__title">Update</h2>

    <form class="form" method="post" action="/admin/support/<%= ticket.id %>/status">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label class="field__label" for="status">Status</label>
        <select class="field__select" id="status" name="status" required>
          <% ['OPEN','IN_PROGRESS','AWAITING_STUDENT','RESOLVED'].forEach(function (status) { %>
            <option value="<%= status %>" <%= ticket.status === status ? 'selected' : '' %>>
              <%= format.humaniseEnum(status) %>
            </option>
          <% }) %>
        </select>
      </div>

      <button class="button button--primary" type="submit">Save</button>
    </form>

    <hr class="rule">

    <form class="form form--inline" method="post" action="/admin/support/<%= ticket.id %>/assign">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label class="field__label" for="assignedToId">Assign to</label>
        <select class="field__select" id="assignedToId" name="assignedToId">
          <option value="">Unassigned</option>
          <% counsellors.forEach(function (counsellor) { %>
            <option value="<%= counsellor.id %>" <%= ticket.assignedToId === counsellor.id ? 'selected' : '' %>>
              <%= counsellor.fullName %>
            </option>
          <% }) %>
        </select>
      </div>

      <button class="button button--secondary" type="submit">Assign</button>
    </form>
  </section>
</div>
