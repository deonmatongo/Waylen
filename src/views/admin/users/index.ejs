<section class="panel">
  <h2 class="panel__title">Invite a staff member</h2>
  <p class="panel__note">
    They'll get an email to choose their own password — nobody here sets it for them.
  </p>

  <form class="form form--inline" method="post" action="/admin/users">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label class="field__label" for="fullName">Full name</label>
      <input class="field__input" type="text" id="fullName" name="fullName" required value="<%= values.fullName || '' %>">
      <% if (errors.fullName) { %><p class="field__error"><%= errors.fullName[0] %></p><% } %>
    </div>

    <div class="field">
      <label class="field__label" for="email">Email</label>
      <input class="field__input" type="email" id="email" name="email" required value="<%= values.email || '' %>">
      <% if (errors.email) { %><p class="field__error"><%= errors.email[0] %></p><% } %>
    </div>

    <div class="field">
      <label class="field__label" for="role">Role</label>
      <select class="field__select" id="role" name="role" required>
        <% roles.forEach(function (role) { %>
          <option value="<%= role %>" <%= values.role === role ? 'selected' : '' %>><%= format.humaniseEnum(role) %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label class="field__label" for="jobTitle">Job title (optional)</label>
      <input class="field__input" type="text" id="jobTitle" name="jobTitle" value="<%= values.jobTitle || '' %>">
    </div>

    <button class="button button--primary" type="submit">Send invite</button>
  </form>
</section>

<% if (!users.length) { %>
  <%- include('../../partials/empty-state', { heading: 'No staff accounts yet' }) %>
<% } else { %>
  <table class="table table--stacked">
    <thead>
      <tr>
        <th scope="col">Name</th><th scope="col">Role</th><th scope="col">Status</th>
        <th scope="col">Last signed in</th><th scope="col"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function (user) { %>
        <tr>
          <td>
            <%= user.fullName %>
            <small class="table__hint"><%= user.email %></small>
            <% if (user.staffProfile && user.staffProfile.jobTitle) { %>
              <small class="table__hint"><%= user.staffProfile.jobTitle %></small>
            <% } %>
          </td>
          <td><%= format.humaniseEnum(user.role) %></td>
          <td>
            <span class="badge badge--<%= user.status === 'ACTIVE' ? 'positive' : 'negative' %>">
              <%= format.humaniseEnum(user.status) %>
            </span>
          </td>
          <td><%= user.lastLoginAt ? format.relativeTime(user.lastLoginAt) : 'Never' %></td>
          <td class="table__actions">
            <form method="post" action="/admin/users/<%= user.id %>/role" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select class="field__select field__select--inline" name="role" aria-label="Change role">
                <% roles.forEach(function (role) { %>
                  <option value="<%= role %>" <%= user.role === role ? 'selected' : '' %>>
                    <%= format.humaniseEnum(role) %>
                  </option>
                <% }) %>
              </select>
              <button class="link-button" type="submit">Save</button>
            </form>

            <% if (user.status === 'ACTIVE') { %>
              <form method="post" action="/admin/users/<%= user.id %>/suspend" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="link-button link-button--danger" type="submit">Suspend</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
