<%#
  Home page — corporate consulting design.
%>

<%# ── Hero ─────────────────────────────────────────────────────────────────── %>
<section class="cp-hero">
  <video class="cp-hero__video" src="/media/hero-web.mp4" autoplay muted loop playsinline
         preload="auto" poster="/img/hero-poster.jpg" aria-hidden="true"></video>
  <div class="cp-hero__wash" aria-hidden="true"></div>

  <div class="cp-hero__inner">
    <div class="cp-hero__copy">
      <div class="cp-hero__eyebrow">
        <span class="cp-hero__eyebrow-line" aria-hidden="true"></span>
        International Education Advisory
      </div>

      <h1 class="cp-hero__title">
        Your pathway to<br>
        <em class="cp-hero__title-em">global opportunity</em>
      </h1>

      <p class="cp-hero__lede">
        Strategic, end-to-end advisory for students pursuing study, careers,
        and financial standing abroad — managed by a dedicated counsellor,
        from first enquiry through to arrival.
      </p>

      <div class="cp-hero__actions">
        <a class="btn btn--corp-gold btn--xl" href="/book-consultation">
          Book a consultation
          <svg class="btn__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="btn btn--corp-ghost btn--xl" href="/register">Create account</a>
      </div>

      <ul class="cp-hero__credentials">
        <li>
          <span class="cp-hero__cred-value">2,400+</span>
          <span class="cp-hero__cred-label">Students placed</span>
        </li>
        <li aria-hidden="true" class="cp-hero__cred-sep"></li>
        <li>
          <span class="cp-hero__cred-value">7</span>
          <span class="cp-hero__cred-label">Destinations</span>
        </li>
        <li aria-hidden="true" class="cp-hero__cred-sep"></li>
        <li>
          <span class="cp-hero__cred-value">98%</span>
          <span class="cp-hero__cred-label">Satisfaction rate</span>
        </li>
      </ul>
    </div>

    <div class="cp-hero__aside" aria-hidden="true">
      <div class="cp-hero__panel">
        <div class="cp-hero__panel-tag">Live client dashboard</div>

        <div class="cp-journey">
          <div class="cp-journey__label">Application progress</div>
          <div class="cp-journey__stages">
            <div class="cp-journey__stage cp-journey__stage--done">
              <span class="cp-journey__dot"></span>
              <span class="cp-journey__name">Profile</span>
            </div>
            <div class="cp-journey__stage cp-journey__stage--done">
              <span class="cp-journey__dot"></span>
              <span class="cp-journey__name">Documents</span>
            </div>
            <div class="cp-journey__stage cp-journey__stage--active">
              <span class="cp-journey__dot"></span>
              <span class="cp-journey__name">In review</span>
            </div>
            <div class="cp-journey__stage">
              <span class="cp-journey__dot"></span>
              <span class="cp-journey__name">Offer</span>
            </div>
            <div class="cp-journey__stage">
              <span class="cp-journey__dot"></span>
              <span class="cp-journey__name">Visa</span>
            </div>
          </div>
        </div>

        <div class="cp-hero__metrics">
          <div class="cp-hero__metric">
            <span class="cp-hero__metric-val">14</span>
            <span class="cp-hero__metric-key">Days to offer</span>
          </div>
          <div class="cp-hero__metric">
            <span class="cp-hero__metric-val">3</span>
            <span class="cp-hero__metric-key">Docs pending</span>
          </div>
          <div class="cp-hero__metric">
            <span class="cp-hero__metric-val">A+</span>
            <span class="cp-hero__metric-key">Profile score</span>
          </div>
        </div>

        <div class="cp-hero__notice cp-hero__notice--success">
          <svg viewBox="0 0 16 16" fill="none" width="14" height="14" aria-hidden="true">
            <path d="M13.5 4L6 11.5 2.5 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Offer received — University of Warsaw MSc
        </div>
      </div>
    </div>
  </div>

  <div class="cp-hero__rule" aria-hidden="true"></div>
</section>

<%# ── Credentials bar ────────────────────────────────────────────────────────── %>
<section class="cp-bar" aria-label="Key statistics">
  <div class="cp-bar__inner">
    <div class="cp-bar__stat">
      <span class="cp-bar__val">2,400+</span>
      <span class="cp-bar__key">Students successfully placed</span>
    </div>
    <div class="cp-bar__div" aria-hidden="true"></div>
    <div class="cp-bar__stat">
      <span class="cp-bar__val">7</span>
      <span class="cp-bar__key">Study destinations covered</span>
    </div>
    <div class="cp-bar__div" aria-hidden="true"></div>
    <div class="cp-bar__stat">
      <span class="cp-bar__val">45 min</span>
      <span class="cp-bar__key">Complimentary consultation</span>
    </div>
    <div class="cp-bar__div" aria-hidden="true"></div>
    <div class="cp-bar__stat">
      <span class="cp-bar__val">End-to-end</span>
      <span class="cp-bar__key">From enquiry through arrival</span>
    </div>
  </div>
</section>

<%# ── Why Waylen ──────────────────────────────────────────────────────────────── %>
<section class="cp-section" aria-labelledby="why-heading">
  <div class="cp-section__inner">
    <div class="cp-section__hd">
      <div class="cp-section__label">Our commitment</div>
      <h2 class="cp-section__title" id="why-heading">A partner, not a portal</h2>
      <p class="cp-section__lede">
        Where other services hand you a list, we assign a counsellor. Every decision,
        document and deadline is managed with one point of accountability — yours.
      </p>
    </div>

    <div class="cp-benefit-feature">
      <figure class="cp-benefit-image">
        <img src="/img/benefit-guidance.jpg" alt="Counsellor guiding a student through their application" loading="lazy">
        <figcaption>Guidance that keeps the process visible from the first conversation.</figcaption>
      </figure>

      <ul class="cp-benefit-list">
        <li class="cp-benefit-point">
          <span aria-hidden="true">01</span>
          <div>
            <h3>Transparent process</h3>
            <p>Track your application from first enquiry through to enrolment, with no guesswork about what happens next.</p>
          </div>
        </li>
        <li class="cp-benefit-point">
          <span aria-hidden="true">02</span>
          <div>
            <h3>Dedicated portal</h3>
            <p>Upload documents, monitor progress and access your offer letters in one place, reviewed by our team.</p>
          </div>
        </li>
        <li class="cp-benefit-point">
          <span aria-hidden="true">03</span>
          <div>
            <h3>Expert counselling</h3>
            <p>Personalised advice from a counsellor who knows your goals, your paperwork and your destination.</p>
          </div>
        </li>
        <li class="cp-benefit-point">
          <span aria-hidden="true">04</span>
          <div>
            <h3>End-to-end support</h3>
            <p>Admission, visa, insurance and the practical business of arriving — one firm, all the way through.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<%# ── Services ─────────────────────────────────────────────────────────────────── %>
<section class="cp-section cp-section--navy" aria-labelledby="services-heading">
  <div class="cp-section__inner">
    <div class="cp-section__hd cp-section__hd--light">
      <div class="cp-section__label cp-section__label--light">Advisory services</div>
      <h2 class="cp-section__title cp-section__title--light" id="services-heading">How we help</h2>
      <p class="cp-section__lede cp-section__lede--light">
        A full suite of advisory services spanning education, career, legal and financial planning.
      </p>
    </div>

    <ul class="cp-services">
      <li class="cp-service">
        <div class="cp-service__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <h3 class="cp-service__title">University applications</h3>
        <p class="cp-service__body">Programme selection, documentation and submission — fully managed.</p>
        <a class="cp-service__link" href="/services/university-applications">Learn more</a>
      </li>
      <li class="cp-service">
        <div class="cp-service__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2M12 12v4M10 14h4"/>
          </svg>
        </div>
        <h3 class="cp-service__title">Career guidance</h3>
        <p class="cp-service__body">Assessments, one-to-one sessions and a career path that extends past your first role.</p>
        <a class="cp-service__link" href="/services/career-guidance">Learn more</a>
      </li>
      <li class="cp-service">
        <div class="cp-service__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
        </div>
        <h3 class="cp-service__title">Consultation booking</h3>
        <p class="cp-service__body">A complimentary 45-minute session with a specialist, online or in person.</p>
        <a class="cp-service__link" href="/book-consultation">Book now</a>
      </li>
      <li class="cp-service">
        <div class="cp-service__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="cp-service__title">Student insurance</h3>
        <p class="cp-service__body">Health and travel cover for abroad, through vetted providers.</p>
        <a class="cp-service__link" href="/services/student-insurance">Learn more</a>
      </li>
      <li class="cp-service">
        <div class="cp-service__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
          </svg>
        </div>
        <h3 class="cp-service__title">Document review</h3>
        <p class="cp-service__body">Every document checked against the institution's requirements before submission.</p>
        <a class="cp-service__link" href="/services/document-review">Learn more</a>
      </li>
      <li class="cp-service">
        <div class="cp-service__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
          </svg>
        </div>
        <h3 class="cp-service__title">Wealth &amp; business</h3>
        <p class="cp-service__body">Credit history, mortgages, investing and company formation once settled.</p>
        <a class="cp-service__link" href="/services/wealth-and-business">Learn more</a>
      </li>
    </ul>

    <div class="cp-section__ft">
      <a class="btn btn--corp-gold" href="/services">View all services</a>
    </div>
  </div>
</section>

<%# ── Destinations ─────────────────────────────────────────────────────────────── %>
<% if (countries.length) { %>
  <section class="cp-section cp-section--tinted" aria-labelledby="destinations-heading">
    <div class="cp-section__inner">
      <div class="cp-section__hd">
        <div class="cp-section__label">Global reach</div>
        <h2 class="cp-section__title" id="destinations-heading">Study destinations</h2>
        <p class="cp-section__lede">In-depth guides to studying, working and building a life in each country.</p>
      </div>

      <ul class="cp-destinations">
        <% countries.forEach(function (country) { %>
          <li class="cp-dest">
            <% if (country.heroImagePath) { %>
              <img class="cp-dest__image" src="<%= country.heroImagePath %>" alt="" width="480" height="270" loading="lazy">
            <% } else { %>
              <div class="cp-dest__image cp-dest__image--placeholder"></div>
            <% } %>
            <div class="cp-dest__body">
              <h3 class="cp-dest__title">
                <% if (country.flagImagePath) { %>
                  <img class="flag-badge" src="<%= country.flagImagePath %>" alt="" width="28" height="20" loading="lazy">
                <% } %>
                <%= country.name %>
              </h3>
              <% if (country.summary) { %>
                <p class="cp-dest__summary"><%= format.truncate(country.summary, 100) %></p>
              <% } %>
              <dl class="cp-dest__facts">
                <div>
                  <dt>Tuition</dt>
                  <dd><%= format.formatTuitionRange(country.indicativeTuitionMin, country.indicativeTuitionMax, country.currency) %></dd>
                </div>
                <% if (country.costOfLivingMonthly) { %>
                  <div>
                    <dt>Cost of living</dt>
                    <dd><%= format.formatMoney(country.costOfLivingMonthly, country.currency) %>/mo</dd>
                  </div>
                <% } %>
              </dl>
              <a class="cp-dest__link" href="/countries/<%= country.slug %>">
                Explore <span class="visually-hidden"><%= country.name %></span>
                <svg viewBox="0 0 12 12" fill="none" width="10" height="10" aria-hidden="true">
                  <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </li>
        <% }) %>
      </ul>

      <div class="cp-section__ft">
        <a class="btn btn--corp-outline" href="/countries">All destinations</a>
      </div>
    </div>
  </section>
<% } %>

<%# ── How it works ─────────────────────────────────────────────────────────────── %>
<section class="cp-section cp-section--navy" aria-labelledby="how-heading">
  <div class="cp-section__inner">
    <div class="cp-section__hd cp-section__hd--light cp-section__hd--center">
      <div class="cp-section__label cp-section__label--light">The process</div>
      <h2 class="cp-section__title cp-section__title--light" id="how-heading">How it works</h2>
      <p class="cp-section__lede cp-section__lede--light">A structured, four-step engagement designed around your timeline and goals.</p>
    </div>

    <svg class="cp-process-line" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M10 60 C120 5 185 110 285 58 S455 8 535 60 S690 112 760 60 S900 8 990 58"/>
    </svg>

    <ol class="cp-process">
      <li class="cp-process__step">
        <div class="cp-process__icon">
          <span class="cp-process__num">01</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--corp-navy)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="30" height="30"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h1"/><path d="M17 14v6M14 17h6"/></svg>
        </div>
        <h3 class="cp-process__title cp-process__title--light">Create your profile</h3>
        <p class="cp-process__body cp-process__body--light">Tell us your goals, target destinations and timeline. Your counsellor reviews everything before your first session.</p>
      </li>
      <li class="cp-process__step">
        <div class="cp-process__icon">
          <span class="cp-process__num">02</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--corp-navy)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="30" height="30"><path d="M4 14.9A5 5 0 0 1 6 5.3a6 6 0 0 1 11.3-1.6A5.5 5.5 0 0 1 20 13.8"/><path d="M12 12v9M9 15l3-3 3 3"/></svg>
        </div>
        <h3 class="cp-process__title cp-process__title--light">Upload your documents</h3>
        <p class="cp-process__body cp-process__body--light">Passport, transcripts, certificates — uploaded to your secure portal, reviewed and verified by our team.</p>
      </li>
      <li class="cp-process__step">
        <div class="cp-process__icon">
          <span class="cp-process__num">03</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--corp-navy)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="30" height="30"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="cp-process__title cp-process__title--light">Meet your counsellor</h3>
        <p class="cp-process__body cp-process__body--light">A focused session to match you to the right institution and programme, with a clear application strategy.</p>
      </li>
      <li class="cp-process__step">
        <div class="cp-process__icon">
          <span class="cp-process__num">04</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--corp-navy)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="30" height="30"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </div>
        <h3 class="cp-process__title cp-process__title--light">We manage the rest</h3>
        <p class="cp-process__body cp-process__body--light">Applications, responses, visa guidance and post-arrival support — tracked in your portal every step of the way.</p>
      </li>
    </ol>
  </div>
</section>

<%# ── Portal preview ─────────────────────────────────────────────────────────── %>
<section class="cp-section cp-section--tinted" aria-labelledby="portal-heading">
  <div class="cp-section__inner cp-split">
    <div class="cp-split__visual" aria-hidden="true">
      <div class="cp-mockup">
        <div class="cp-mockup__bar">
          <span class="cp-mockup__dot"></span>
          <span class="cp-mockup__dot"></span>
          <span class="cp-mockup__dot"></span>
          <span class="cp-mockup__url">waylen.app/portal</span>
        </div>
        <div class="cp-mockup__sidebar">
          <div class="cp-mockup__logo"></div>
          <div class="cp-mockup__nav">
            <div class="cp-mockup__nav-item cp-mockup__nav-item--active"></div>
            <div class="cp-mockup__nav-item"></div>
            <div class="cp-mockup__nav-item"></div>
            <div class="cp-mockup__nav-item"></div>
          </div>
        </div>
        <div class="cp-mockup__main">
          <div class="cp-mockup__heading"></div>
          <div class="cp-mockup__tracker">
            <div class="cp-mockup__t-step cp-mockup__t-step--done"></div>
            <div class="cp-mockup__t-step cp-mockup__t-step--done"></div>
            <div class="cp-mockup__t-step cp-mockup__t-step--active"></div>
            <div class="cp-mockup__t-step"></div>
            <div class="cp-mockup__t-step"></div>
          </div>
          <div class="cp-mockup__cards">
            <div class="cp-mockup__card cp-mockup__card--gold">
              <div class="cp-mockup__card-val"></div>
              <div class="cp-mockup__card-key"></div>
            </div>
            <div class="cp-mockup__card cp-mockup__card--navy">
              <div class="cp-mockup__card-val"></div>
              <div class="cp-mockup__card-key"></div>
            </div>
            <div class="cp-mockup__card cp-mockup__card--grey">
              <div class="cp-mockup__card-val"></div>
              <div class="cp-mockup__card-key"></div>
            </div>
          </div>
          <div class="cp-mockup__row"></div>
          <div class="cp-mockup__row cp-mockup__row--short"></div>
          <div class="cp-mockup__notice">
            <div class="cp-mockup__notice-dot"></div>
            <div class="cp-mockup__notice-text"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="cp-split__copy">
      <div class="cp-section__label">Client portal</div>
      <h2 class="cp-section__title" id="portal-heading">Your entire journey, in one secure place</h2>
      <p class="cp-section__lede">
        Every client receives a dedicated portal — application status, document centre,
        consultation records and notifications — so you always know exactly where you stand.
      </p>
      <ul class="cp-checklist">
        <li>Stage-by-stage application tracker</li>
        <li>Document centre with staff review and annotations</li>
        <li>Offer letters and visa support letters ready to download</li>
        <li>Secure messaging with your assigned counsellor</li>
      </ul>
      <a class="btn btn--corp-primary" href="/register">Access your portal</a>
    </div>
  </div>
</section>

<%# ── Testimonials ─────────────────────────────────────────────────────────────── %>
<% if (testimonials.length) { %>
  <section class="cp-section" aria-labelledby="stories-heading">
    <div class="cp-section__inner">
      <div class="cp-section__hd">
        <div class="cp-section__label">Client outcomes</div>
        <h2 class="cp-section__title" id="stories-heading">From our clients</h2>
      </div>

      <ul class="cp-quotes">
        <% testimonials.forEach(function (testimonial) { %>
          <li class="cp-quote">
            <div class="cp-quote__mark" aria-hidden="true">&ldquo;</div>
            <blockquote class="cp-quote__body">
              <p><%= testimonial.quote %></p>
            </blockquote>
            <footer class="cp-quote__footer">
              <span class="cp-quote__avatar" aria-hidden="true"><%= format.initials(testimonial.authorName) %></span>
              <div>
                <strong class="cp-quote__name"><%= testimonial.authorName %></strong>
                <% if (testimonial.authorRole || testimonial.countryName) { %>
                  <small class="cp-quote__role">
                    <%= [testimonial.authorRole, testimonial.countryName].filter(Boolean).join(' · ') %>
                  </small>
                <% } %>
              </div>
            </footer>
          </li>
        <% }) %>
      </ul>
    </div>
  </section>
<% } %>

<%# ── Latest articles ─────────────────────────────────────────────────────────── %>
<% if (articles.length) { %>
  <section class="cp-section cp-section--tinted" aria-labelledby="articles-heading">
    <div class="cp-section__inner">
      <div class="cp-section__hd">
        <div class="cp-section__label">Insights</div>
        <h2 class="cp-section__title" id="articles-heading">Guides &amp; resources</h2>
      </div>

      <ul class="cp-articles">
        <% articles.forEach(function (article) { %>
          <li class="cp-article">
            <% if (article.coverImagePath) { %>
              <img class="cp-article__image" src="<%= article.coverImagePath %>" alt="" width="480" height="270" loading="lazy">
            <% } else { %>
              <div class="cp-article__image cp-article__image--placeholder"></div>
            <% } %>
            <div class="cp-article__body">
              <span class="cp-article__type"><%= format.humaniseEnum(article.type) %></span>
              <h3 class="cp-article__title"><%= article.title %></h3>
              <% if (article.excerpt) { %>
                <p class="cp-article__excerpt"><%= format.truncate(article.excerpt, 110) %></p>
              <% } %>
              <a class="cp-article__link" href="/learning-hub/<%= article.slug %>">
                Read more
                <svg viewBox="0 0 12 12" fill="none" width="10" height="10" aria-hidden="true">
                  <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>
  </section>
<% } %>

