<%# PRD §4.9 — the dedicated institutional credibility page. %>
<section class="page-hero">
  <div class="section__inner">
    <h1 class="page-hero__title">For institutions</h1>
    <p class="page-hero__lede">
      A single, accountable, well-organised representative across Africa — not an
      unpredictable, informal channel.
    </p>
  </div>
</section>

<section class="section">
  <div class="section__inner">
    <ul class="card-grid card-grid--2">
      <li class="card card--feature">
        <h2 class="card__title">A vetted candidate pipeline</h2>
        <p class="card__body">Well-documented candidates from across Africa, screened before they reach you.</p>
      </li>
      <li class="card card--feature">
        <h2 class="card__title">Verified documentation</h2>
        <p class="card__body">Standardised, verified paperwork before any application is submitted — no incomplete files.</p>
      </li>
      <li class="card card--feature">
        <h2 class="card__title">One point of contact</h2>
        <p class="card__body">A single accountable relationship rather than fragmented individual enquiries.</p>
      </li>
      <li class="card card--feature">
        <h2 class="card__title">Transparent tracking</h2>
        <p class="card__body">Every application tracked from submission through to enrolment, visible to both sides.</p>
      </li>
      <li class="card card--feature">
        <h2 class="card__title">Data protection by design</h2>
        <p class="card__body">GDPR-level standards: encrypted document storage, full audit trail and a clear retention policy.</p>
      </li>
      <li class="card card--feature">
        <h2 class="card__title">A long-term relationship</h2>
        <p class="card__body">A lasting regional presence and reputation, not a one-off recruiter arrangement.</p>
      </li>
    </ul>
  </div>
</section>

<section class="section section--muted">
  <div class="section__inner section__inner--narrow">
    <h2 class="section__title">Talk to us about a recruitment agreement</h2>

    <form class="form" method="post" action="/contact">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="countryOfInterest" value="institution-enquiry">

      <div class="field">
        <label class="field__label" for="fullName">Your name</label>
        <input class="field__input" type="text" id="fullName" name="fullName" required>
      </div>

      <div class="field">
        <label class="field__label" for="email">Work email address</label>
        <input class="field__input" type="email" id="email" name="email" required>
      </div>

      <div class="field">
        <label class="field__label" for="message">Your institution and what you are looking for</label>
        <textarea class="field__textarea" id="message" name="message" rows="5" required></textarea>
      </div>

      <button class="button button--primary" type="submit">Send enquiry</button>
    </form>
  </div>
</section>
