<%# PRD §A.13 — reachable before registration, so no account is required. %>
<section class="page-hero">
  <div class="section__inner">
    <h1 class="page-hero__title">Book a free consultation</h1>
    <p class="page-hero__lede">
      A 45-minute session with a counsellor — online or in person — to get a
      clear view of your options.
    </p>
  </div>
</section>

<section class="section">
  <div class="section__inner section__inner--narrow">
    <form class="form" method="post" action="/book-consultation" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="field">
        <label class="field__label" for="fullName">Full name</label>
        <input class="field__input" type="text" id="fullName" name="fullName"
               value="<%= values.fullName || '' %>" autocomplete="name" required>
        <% if (errors.fullName) { %><p class="field-error"><%= errors.fullName[0] %></p><% } %>
      </div>

      <div class="field">
        <label class="field__label" for="email">Email address</label>
        <input class="field__input" type="email" id="email" name="email"
               value="<%= values.email || '' %>" autocomplete="email" required>
        <% if (errors.email) { %><p class="field-error"><%= errors.email[0] %></p><% } %>
      </div>

      <div class="field">
        <label class="field__label" for="phone">Phone (optional)</label>
        <input class="field__input" type="tel" id="phone" name="phone"
               value="<%= values.phone || '' %>" autocomplete="tel">
      </div>

      <div class="field">
        <label class="field__label" for="type">What would you like to discuss?</label>
        <select class="field__select" id="type" name="type">
          <% Object.entries(appointmentTypes).forEach(function (entry) { %>
            <option value="<%= entry[0] %>" <%= values.type === entry[0] ? 'selected' : '' %>>
              <%= entry[1] %>
            </option>
          <% }) %>
        </select>
      </div>

      <fieldset class="field field--fieldset">
        <legend class="field__label">How would you like to meet?</legend>
        <label class="radio">
          <input type="radio" name="format" value="ONLINE" checked>
          <span>Online — we will send a Microsoft Teams link</span>
        </label>
        <label class="radio">
          <input type="radio" name="format" value="IN_PERSON">
          <span>In person at one of our offices</span>
        </label>
      </fieldset>

      <div class="field">
        <span class="field__label">Choose a time</span>

        <% if (!slotDays.length) { %>
          <p class="field__hint">No open slots in the next three weeks — please email us directly.</p>
        <% } else { %>
          <div class="slot-picker">
            <% slotDays.forEach(function (day) { %>
              <fieldset class="slot-picker__day">
                <legend class="slot-picker__date"><%= format.formatDate(day.slots[0], 'EEEE d MMMM') %></legend>
                <div class="slot-picker__times">
                  <% day.slots.forEach(function (slot) { %>
                    <% var iso = slot.toISOString(); %>
                    <label class="slot-chip">
                      <input type="radio" name="startsAt" value="<%= iso %>"
                             <%= values.startsAt === iso ? 'checked' : '' %> required>
                      <span><%= format.formatDate(slot, 'HH:mm') %></span>
                    </label>
                  <% }) %>
                </div>
              </fieldset>
            <% }) %>
          </div>
        <% } %>

        <p class="field__hint">
          <% if (liveAvailability) { %>
            Live availability from our calendar — pick any open time and you are instantly booked,
            with a Teams link sent straight to your inbox.
          <% } else { %>
            We will confirm by email, or suggest the nearest available slot.
          <% } %>
        </p>
        <% if (errors.startsAt) { %><p class="field-error"><%= errors.startsAt[0] %></p><% } %>
      </div>

      <div class="field">
        <label class="field__label" for="notes">Anything we should know beforehand? (optional)</label>
        <textarea class="field__textarea" id="notes" name="notes" rows="4"><%= values.notes || '' %></textarea>
      </div>

      <button class="button button--primary button--large" type="submit">
        <%= liveAvailability ? 'Confirm booking' : 'Request consultation' %>
      </button>
    </form>
  </div>
</section>
