# Generated CSS/JS bundles
public/css/app.min.css
public/js/app.min.js

# Prisma
prisma/*.db
prisma/*.db-journal
prisma/**/*.db
prisma/**/*.db-journal

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*

# Test & coverage
coverage/
.nyc_output/

# Editor / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
.vercel

