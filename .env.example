# ─────────────────────────────────────────────────────────────
# Waylen Platform — environment template
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=Waylen
APP_URL=http://localhost:3000
# Comma-separated list of hosts allowed to make state-changing requests
TRUSTED_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://waylen:waylen@localhost:5432/waylen_dev?schema=public

# ── Sessions & CSRF ─────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string
CSRF_SECRET=replace-me-with-a-different-long-random-string
SESSION_TTL_HOURS=24

# ── Document encryption (PRD 8.2 — encrypted storage at rest) ──
# 32-byte key, base64. Generate with: openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY=replace-me-32-byte-base64-key

# ── File storage ────────────────────────────────────────────
# local | s3   (local for dev; move to s3-compatible object storage in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./public/uploads
MAX_UPLOAD_SIZE_MB=15

# S3 / object storage (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (PRD 8.1 — notification & reminder automation) ────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Waylen
MAIL_FROM_ADDRESS=hello@waylen.example

# ── Payments (PRD 8.1 — evaluate per region) ────────────────
# Card / Apple Pay / Google Pay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# African regional processors — enable per country
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Bank transfer / SWIFT / Revolut are recorded manually by admin staff

# ── Appointments — Microsoft Teams + real Outlook availability (PRD 5.2) ────
# Requires an Azure AD app registration (Azure Portal → App registrations →
# New registration), app-only (client credentials), with these Application
# API permissions granted admin consent under Microsoft Graph:
#   Calendars.ReadWrite   — read free/busy and create the booked event
# MS_GRAPH_ORGANISER_UPN is the mailbox whose calendar is checked and booked
# into (e.g. counsellor@yourdomain.com) — it must be a real mailbox in the
# same tenant as the app registration. Leave all four blank to keep the
# request-then-confirm flow with a placeholder Teams link (no Azure setup
# required for local development).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_ORGANISER_UPN=
MS_GRAPH_TIMEZONE=UTC

# ── Observability ───────────────────────────────────────────
LOG_LEVEL=debug
# Optional error tracking
SENTRY_DSN=

# ── Feature flags — line up with the PRD phasing (section 9) ──
FEATURE_PAYMENTS=false
FEATURE_INSURANCE=false
FEATURE_PARTNER_DIRECTORY=false
FEATURE_COMMUNITY=false
FEATURE_AGENT_PORTAL=false
