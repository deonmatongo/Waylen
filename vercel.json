{
  "version": 2,
  "installCommand": "npm install --include=dev && npx prisma generate && npx prisma migrate deploy && npm run build:ts && npm run build:views",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,public/**,prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/cron/appointment-reminders", "schedule": "0 * * * *" },
    { "path": "/cron/webinar-reminders", "schedule": "0 * * * *" },
    { "path": "/cron/overdue-invoices", "schedule": "0 */12 * * *" }
  ]
}
