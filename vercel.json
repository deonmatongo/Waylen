{
  "version": 2,
  "installCommand": "npm install --include=dev && npx prisma generate",
  "buildCommand": "npm run build:ts && npm run build:views && npm run build:css && if [ \"$VERCEL_ENV\" = \"production\" ]; then npx prisma migrate deploy; else echo \"Skipping prisma migrate deploy (VERCEL_ENV=$VERCEL_ENV)\"; fi",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,public/**,prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/cron/appointment-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/cron/webinar-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/cron/overdue-invoices",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/cron/retention",
      "schedule": "0 3 * * *"
    }
  ]
}
